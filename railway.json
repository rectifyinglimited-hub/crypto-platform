{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm --prefix backend ci --omit=dev",
    "watchPatterns": [
      "backend/**",
      "package.json",
      "nixpacks.toml",
      "railway.json",
      "scripts/**"
    ]
  },
  "deploy": {
    "startCommand": "node scripts/start-api.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
